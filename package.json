{
  "name": "dzship",
  "version": "1.3.0",
  "description": "Typed client for dzship, the free shipping API for Algeria. Create and track COD parcels with 101 couriers (Yalidine, ZR Express, Maystro, NOEST, Osen Express, Terminal Delivery, DHD and every Ecotrack courier) through one request shape.",
  "license": "MIT",
  "homepage": "https://freeship.dzbuild.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZBuild-com/dzship.git"
  },
  "main": "clients/node/index.cjs",
  "types": "clients/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./clients/node/index.d.ts",
      "import": "./clients/node/index.mjs",
      "require": "./clients/node/index.cjs"
    }
  },
  "files": [
    "clients/node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "algeria",
    "shipping",
    "delivery",
    "cod",
    "cash-on-delivery",
    "yalidine",
    "zr-express",
    "procolis",
    "maystro",
    "noest",
    "ecotrack",
    "osen-express",
    "terminal-delivery",
    "zimou",
    "sdk",
    "typescript",
    "dhd",
    "conexlog",
    "wilaya",
    "communes",
    "dzbuild",
    "livraison",
    "algerie",
    "dz"
  ],
  "author": "DZBuild (https://dzbuild.com)"
}
